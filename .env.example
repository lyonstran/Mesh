# Backend
MONGODB_URI=                      # TODO(HUMAN): Atlas SRV string
MONGODB_DB=mesh
JWT_SECRET=                       # long random string
JWT_TTL_HOURS=24
GOOGLE_CLIENT_ID=                 # TODO(HUMAN): OAuth Web client ID
COOKIE_SECURE=false               # true in prod
DEMO_LOGIN=false                  # true only for local/demo; enables seeded-user login (python -m app.seed --reset)
COORDINATOR_INVITE_CODE=          # TODO(HUMAN): choose a code
NWS_USER_AGENT=(Mesh, team-email@example.com)   # TODO(HUMAN): real contact email
MUSE_API_KEY=                     # TODO(HUMAN)
MUSE_BASE_URL=https://api.meta.ai/v1           # docs/muse-api.md
MUSE_TEXT_MODEL=muse-spark-1.3                 # docs/muse-api.md
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
LLM_PROVIDER=mock                 # mock | muse  (muse needs MUSE_API_KEY; falls back to mock without it)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # fastembed, runs locally (PLAN.md §0.1)
VECTOR_SEARCH=auto                # auto | atlas | local  (auto: Atlas Vector Search if available, else in-Python cosine)
ELEVENLABS_API_KEY=               # TODO(HUMAN)
ELEVENLABS_VOICE_ID=              # TODO(HUMAN): pick a multilingual voice
ELEVENLABS_MODEL_ID=eleven_multilingual_v2   # verify against current docs
HAZARD_CACHE_SECONDS=300
DEFAULT_TIMEZONE=America/New_York
REALTIME_MODE=poll                # poll | ws  (PLAN.md §10: polling first, WebSocket after M3)

# Frontend (Vite, must be prefixed VITE_)
VITE_GOOGLE_CLIENT_ID=
VITE_DEMO_LOGIN=false             # match DEMO_LOGIN
VITE_MAP_TILE_URL=                # optional; defaults to OpenStreetMap tiles (keep the attribution)
