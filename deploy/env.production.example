# Production settings. On the VM: cp deploy/env.production.example .env, then fill in the blanks.
# Do NOT commit the real .env. Keep comments on their own lines, never after a value: Docker Compose can read
# a trailing "# comment" as part of the value.

# --- Database (MongoDB Atlas). The VM's public IP must be allowed in Atlas > Network Access.
MONGODB_URI=
MONGODB_DB=mesh

# --- Sessions. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=24
# Must be true on a real domain so the session cookie is only sent over HTTPS.
COOKIE_SECURE=true

# --- Google sign-in. https://<your domain> must be an authorized JavaScript origin on this OAuth client.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Demo login. Lets anyone sign in as a seeded demo user: fine for judging, not for a real launch.
# DEMO_LOGIN and VITE_DEMO_LOGIN must be the same value. VITE_DEMO_LOGIN is baked in at build time.
DEMO_LOGIN=true
VITE_DEMO_LOGIN=true

# --- Domain served by Caddy (HTTPS certificate is requested for this name).
SITE_DOMAIN=mesh-together.tech

# --- Other backend settings
COORDINATOR_INVITE_CODE=
NWS_USER_AGENT="(Mesh, your-real-email@example.com)"
HAZARD_CACHE_SECONDS=300
DEFAULT_TIMEZONE=America/New_York
REALTIME_MODE=poll
VECTOR_SEARCH=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- AI and voice. Everything works with LLM_PROVIDER=mock and no keys.
LLM_PROVIDER=mock
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_TEXT_MODEL=muse-spark-1.3
MUSE_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Map tiles. Leave blank for OpenStreetMap (keep its attribution if you change provider).
VITE_MAP_TILE_URL=
